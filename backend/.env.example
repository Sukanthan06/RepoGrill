# LLM + speech-to-text (any OpenAI-compatible provider; defaults to Groq)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Run `python scripts/discover_models.py --write` to fill these three
LLM_MODEL=
LLM_FAST_MODEL=
STT_MODEL=

# GitHub REST API: personal access token (public_repo read is enough).
# Optional, but without it GitHub allows only 60 requests/hour.
GITHUB_TOKEN=

# Comma-separated list of allowed browser origins in production
FRONTEND_ORIGIN=

# Optional tuning
LOG_LEVEL=INFO
SESSION_TTL_SECONDS=7200
