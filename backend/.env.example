# LLM + speech-to-text (any OpenAI-compatible provider; defaults to Groq)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Run `python scripts/discover_models.py --write` to fill these three
LLM_MODEL=
LLM_FAST_MODEL=
STT_MODEL=

# GitHub REST API: personal access token (public_repo read is enough).
# Optional, but without it GitHub allows only 60 requests/hour.
GITHUB_TOKEN=

# "production" disables the localhost CORS origins
APP_ENV=development
# Comma-separated list of allowed browser origins (your Vercel URL in production)
FRONTEND_ORIGIN=

# Optional tuning
LOG_LEVEL=INFO
SESSION_TTL_SECONDS=7200
# Reasoning effort for reasoning models (e.g. low|medium|high); leave empty if unsupported
LLM_REASONING_EFFORT=low
# Max prompt tokens for dossier generation (keep under your provider's per-minute cap)
DOSSIER_INPUT_TOKENS=4500
